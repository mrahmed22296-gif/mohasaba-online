{
  "cleanUrls": false,
  "routes": [
    { "src": "^/$", "status": 404 },
    { "src": "^/customers/?$", "dest": "/customers.html" },
    { "src": "^/api/owner-data/?$", "dest": "/api/owner-data.js" },
    { "src": "^/api/generate/?$", "dest": "/api/generate.js" },
    { "src": "^/api/redeem/?$", "dest": "/api/redeem.js" },
    { "src": ".*", "status": 404 }
  ]
}
